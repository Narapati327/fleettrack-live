# Copy this file to .env and fill in your values.

# ---------- Server ----------
PORT=8080
# Secret key for the dashboard, API and MCP server. Anyone with it can read and change data.
# Leave empty only while testing on your own computer.
API_KEY=change-me-to-a-long-random-string
COMPANY_NAME=FleetTrack

# ---------- GPS / telematics ----------
# "simulator" = fake moving trucks (for testing)
# "generic"   = any provider with a REST API that returns a list of vehicles as JSON
GPS_PROVIDER=simulator
GPS_POLL_SECONDS=15

# Settings for GPS_PROVIDER=generic
GPS_API_URL=https://api.your-gps-provider.com/v1/vehicles/locations
GPS_API_KEY=
# How the key is sent. Examples: "Authorization: Bearer {key}"  or  "X-Api-Key: {key}"
GPS_AUTH_HEADER=Authorization: Bearer {key}
# Where the vehicle list sits in the JSON response (dot path). Empty = the response itself is the list.
GPS_ITEMS_PATH=data
# Field names inside each vehicle item (dot paths allowed, e.g. "location.latitude")
GPS_FIELD_ID=id
GPS_FIELD_LAT=latitude
GPS_FIELD_LNG=longitude
GPS_FIELD_SPEED=speed
GPS_FIELD_HEADING=heading
GPS_FIELD_FUEL=fuelPercent
GPS_FIELD_ODOMETER=odometerKm
GPS_FIELD_TIME=time
# Set to 1.609 if your provider reports speed in mph
GPS_SPEED_MULTIPLIER=1

# ---------- Shipments ----------
# "local"  = saved in data/shipments.json on this server
# "sheets" = read and written in your Google Sheet through the Apps Script in google-apps-script/Code.gs
SHIPMENTS_PROVIDER=local
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXX/exec
SHEETS_SECRET=the-same-secret-you-put-in-Code.gs
SHEETS_SYNC_SECONDS=30

# ---------- Alerts ----------
ALERT_LOW_FUEL=20
ALERT_OVERSPEED_KMH=80
ALERT_OFFLINE_MINUTES=10
# Average speed used for ETAs when a truck is stopped or crawling
ETA_FALLBACK_KMH=25
# Mark a shipment delivered automatically when its truck stops within this many meters
# of the destination. Set to 0 to turn this off and mark deliveries by hand.
AUTO_DELIVER_RADIUS_M=200

# ---------- Weather (Open-Meteo, free, no key) ----------
WEATHER_ENABLED=true
WEATHER_REFRESH_MINUTES=10
# Add this much to ETAs when heavy rain or storms are at the destination
WEATHER_ETA_SLOWDOWN_PERCENT=25

# ---------- Address search (Nominatim / OpenStreetMap, free, no key) ----------
GEOCODE_ENABLED=true
# Limit searches to a country (ISO code). Empty = worldwide.
GEOCODE_COUNTRY=ph
# Nominatim asks apps to identify themselves; put a contact email here.
GEOCODE_CONTACT_EMAIL=

# ---------- Telegram alerts (free) ----------
# 1) In Telegram, open @BotFather, send /newbot, copy the token below.
# 2) Send your bot a message, then run:  npm.cmd run telegram   to get your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# What to send: created, delivered, alerts (comma separated)
TELEGRAM_NOTIFY=created,delivered,alerts
